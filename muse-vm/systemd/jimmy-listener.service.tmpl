[Unit]
Description=Jimmy inbox HTTP listener (Hermes push events, 127.0.0.1:8899)
After=network.target
Wants=network.target

[Service]
Type=simple
Environment=HOME=/home/hatch
Environment=HTTPS_PROXY=__HTTPS_PROXY__
ExecStart=/usr/bin/python3 /home/hatch/workspace/bin/jimmy-inbox-listener.py
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
