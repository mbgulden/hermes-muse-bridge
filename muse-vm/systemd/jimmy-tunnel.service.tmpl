[Unit]
Description=Jimmy reverse SSH tunnel (box -> VM listener for kanban push)
After=network.target
Wants=network.target

[Service]
Type=simple
Environment=HOME=/home/hatch
Environment=HTTPS_PROXY=__HTTPS_PROXY__
ExecStart=/home/hatch/workspace/bin/jimmy-tunnel.sh
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
