# kanban-stream — environment template
#
# Copy the relevant lines into the .env of the PROFILE that runs the
# kanban workers (or export them in the worker/gateway environment).
# Hermes resolves these through agent.secret_scope.get_secret(), so they
# must be visible to the profile scope — never hardcode tokens in the
# plugin.
#
# NO real values in this file. Placeholders only.

# REQUIRED — Telegram bot token for the ops bot (create one via @BotFather).
# This is a DEDICATED bot for the ops dashboard, not your chat bot.
# Namespaced KANBAN_STREAM_* on purpose: the built-in Telegram gateway
# platform already uses TELEGRAM_BOT_TOKEN / TELEGRAM_ALLOWED_USERS for
# the profile's chat bot, and this plugin must not reuse those.
KANBAN_STREAM_BOT_TOKEN=123456789:AA...your-bot-token...

# REQUIRED — comma-separated Telegram user IDs allowed to (a) receive the
# stream (first id, when KANBAN_STREAM_OPS_CHAT_ID is unset) and (b) issue
# /steer from the companion daemon. Find your numeric id via @userinfobot.
KANBAN_STREAM_ALLOWED_USERS=111111111,222222222

# OPTIONAL — explicit destination chat id for the stream (a group or 1:1
# chat the bot belongs to). When unset, the first id in
# KANBAN_STREAM_ALLOWED_USERS is used (1:1 streaming mode).
KANBAN_STREAM_OPS_CHAT_ID=

# OPTIONAL — author label stamped on [steer] comments posted by the
# companion daemon (default: "operator").
# KANBAN_STREAM_STEER_AUTHOR=michael

# Path overrides (rarely needed; the plugin derives these automatically):
# HERMES_KANBAN_DB=/absolute/path/to/kanban.db
